<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/linen"
    android:fitsSystemWindows="true">

    <!-- Brand top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/harbor"
        android:paddingHorizontal="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/topbarLogo"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_logo_mark"
            android:contentDescription="@string/app_name"
            android:layout_marginEnd="10dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/topbarFlatName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/paper"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Flat 4B"/>

            <TextView
                android:id="@+id/topbarSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#C7D4DE"
                android:textSize="12sp"
                tools:text="3 flatmates · RoomieSync"/>
        </LinearLayout>

        <TextView
            android:id="@+id/topbarBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_home"
            android:textColor="@color/paper"
            android:padding="6dp"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- Body: fragment container + floating action button -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:src="@drawable/ic_add"
            app:backgroundTint="@color/harbor"
            app:tint="@color/paper"
            app:fabSize="normal"
            android:contentDescription="@string/add_expense"/>
    </FrameLayout>

    <!-- Bottom navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/paper"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:menu="@menu/bottom_nav_menu"/>

</LinearLayout>
