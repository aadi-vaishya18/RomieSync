<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="90dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_profile"
            android:textColor="@color/ink"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            style="@style/RoomieSync.SectionLabel"
            android:text="@string/your_flat"/>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:padding="4dp">

            <EditText
                android:id="@+id/flatNameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:padding="10dp"
                android:textSize="14.5sp"
                android:textColor="@color/ink"
                android:inputType="textCapWords"
                android:imeOptions="actionDone"
                android:singleLine="true"
                tools:text="Flat 4B"/>
        </FrameLayout>

        <TextView
            style="@style/RoomieSync.SectionLabel"
            android:text="@string/you_are"/>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/whoamiChipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true"/>

        <TextView
            style="@style/RoomieSync.SectionLabel"
            android:text="@string/flatmates"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/flatmatesList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addFlatmateBtn"
            style="@style/RoomieSync.OutlineButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/add_flatmate"
            android:textAllCaps="false"
            app:icon="@drawable/ic_add"
            app:iconTint="@color/harbor"/>

        <TextView
            style="@style/RoomieSync.SectionLabel"
            android:text="Data"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/resetDataBtn"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reset_demo_data"
            android:textAllCaps="false"
            android:textColor="@color/clay"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
