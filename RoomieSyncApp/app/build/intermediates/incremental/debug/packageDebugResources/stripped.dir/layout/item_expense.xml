<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card"
    android:padding="12dp"
    android:layout_marginBottom="9dp">

    <TextView
        android:id="@+id/expenseAvatar"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_avatar_circle"
        android:gravity="center"
        android:textColor="@color/paper"
        android:textStyle="bold"
        android:textSize="12sp"
        tools:text="MI"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/expenseTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ink"
            android:textSize="14.5sp"
            android:textStyle="bold"
            tools:text="Groceries"/>

        <TextView
            android:id="@+id/expenseSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ink_faint"
            android:textSize="11.5sp"
            android:layout_marginTop="1dp"
            tools:text="Paid by Meera · split 3 ways"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/expenseAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ink"
            android:textStyle="bold"
            android:textSize="14.5sp"
            tools:text="₹840"/>

        <TextView
            android:id="@+id/expenseDelete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/delete"
            android:textColor="@color/clay"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_marginTop="2dp"/>
    </LinearLayout>
</LinearLayout>
