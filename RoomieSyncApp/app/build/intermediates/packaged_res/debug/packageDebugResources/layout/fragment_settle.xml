<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="90dp">

        <TextView
            style="@style/RoomieSync.SectionLabel"
            android:layout_marginTop="0dp"
            android:text="@string/your_balances"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/myBalancesList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"/>

        <TextView
            android:id="@+id/myBalancesEmpty"
            style="@style/RoomieSync.EmptyState"
            android:text="@string/empty_settled"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/otherBalancesLabel"
            style="@style/RoomieSync.SectionLabel"
            android:text="@string/other_flat_balances"
            android:visibility="gone"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/otherBalancesList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"/>

        <TextView
            style="@style/RoomieSync.SectionLabel"
            android:text="@string/payment_log"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/paymentLogList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"/>

        <TextView
            android:id="@+id/paymentLogEmpty"
            style="@style/RoomieSync.EmptyState"
            android:text="@string/empty_payments"
            android:visibility="gone"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settle_hint"
            android:textSize="11.5sp"
            android:textColor="@color/ink"
            android:alpha="0.55"
            android:lineSpacingExtra="3dp"
            android:layout_marginTop="8dp"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
